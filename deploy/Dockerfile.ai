FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app/t7/Python/aiWatchdog-main
COPY t7/Python/aiWatchdog-main/requirements.production.txt ./
RUN pip install --no-cache-dir -r requirements.production.txt
COPY t7/Python/aiWatchdog-main/config.py t7/Python/aiWatchdog-main/django_integration.py \
    t7/Python/aiWatchdog-main/multi_modal_analyzer.py t7/Python/aiWatchdog-main/prompt.py \
    t7/Python/aiWatchdog-main/utility.py t7/Python/aiWatchdog-main/video_recording.py \
    t7/Python/aiWatchdog-main/video_server.py ./
RUN mkdir -p /app/t7/front/public/video/abnormal /app/t7/front/public/video/thumbnails /data/ai

EXPOSE 16532
CMD ["python", "video_server.py"]
