FROM python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    DJANGO_SETTINGS_MODULE=community_project.settings_production

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential pkg-config default-libmysqlclient-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app/t7/Python/community_system
COPY t7/Python/community_system/requirements.production.txt ./
RUN pip install --no-cache-dir -r requirements.production.txt
COPY t7/Python/community_system/community_project ./community_project
COPY t7/Python/community_system/core ./core
COPY t7/Python/community_system/static ./static
COPY t7/Python/community_system/manage.py ./manage.py
COPY deploy/web-entrypoint.sh /app/web-entrypoint.sh
RUN mkdir -p /app/t7/front/public /data/static \
    && chmod +x /app/web-entrypoint.sh

EXPOSE 8000
CMD ["/app/web-entrypoint.sh"]
